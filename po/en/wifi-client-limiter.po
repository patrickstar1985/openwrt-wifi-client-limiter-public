msgid "WiFi Client Limiter"
msgstr "WiFi Client Limiter"

msgid "Global limit across selected WiFi networks. Protected devices are excluded from client limits and Internet restrictions. A reconnect cooldown can delay new connections after a disconnect."
msgstr "Global limit across selected WiFi networks. Protected devices are excluded from client limits and Internet restrictions. A reconnect cooldown can delay new connections after a disconnect."

msgid "Settings"
msgstr "Settings"

msgid "Enabled"
msgstr "Enabled"

msgid "Test mode"
msgstr "Test mode"

msgid "Log actions only. Do not disconnect devices or change Internet access."
msgstr "Log actions only. Do not disconnect devices or change Internet access."

msgid "Maximum number of guests"
msgstr "Maximum number of guests"

msgid "0 = unlimited. Disconnect only when the limit is exceeded."
msgstr "0 = unlimited. Disconnect only when the limit is exceeded."

msgid "Maximum connection duration (seconds)"
msgstr "Maximum connection duration (seconds)"

msgid "0 = unlimited. 1800 = 30 minutes."
msgstr "0 = unlimited. 1800 = 30 minutes."

msgid "Check interval (seconds)"
msgstr "Check interval (seconds)"

msgid "WiFi networks to manage"
msgstr "WiFi networks to manage"

msgid "Select the WiFi networks on which client limits should apply. Protected devices are excluded. No action is taken if no network is selected."
msgstr "Select the WiFi networks on which client limits should apply. Protected devices are excluded. No action is taken if no network is selected."

msgid "Protected MAC addresses"
msgstr "Protected MAC addresses"

msgid "Add administrator devices, servers and other permanent devices here. Check for private MAC addresses."
msgstr "Add administrator devices, servers and other permanent devices here. Check for private MAC addresses."

msgid "Setup wizard"
msgstr "Setup wizard"

msgid "Start setup wizard"
msgstr "Start setup wizard"

msgid "Select WiFi networks to manage"
msgstr "Select WiFi networks to manage"

msgid "Choose the WiFi networks on which client limits should apply. The wizard does not change WiFi configuration."
msgstr "Choose the WiFi networks on which client limits should apply. The wizard does not change WiFi configuration."

msgid "Select at least one access point."
msgstr "Select at least one access point."

msgid "No access points are configured. Create a WiFi network in Network / Wireless first."
msgstr "No access points are configured. Create a WiFi network in Network / Wireless first."

msgid "Protect important devices"
msgstr "Protect important devices"

msgid "Select the connected WiFi devices that must never be disconnected. You can also enter MAC addresses manually."
msgstr "Select the connected WiFi devices that must never be disconnected. You can also enter MAC addresses manually."

msgid "Connected WiFi devices"
msgstr "Connected WiFi devices"

msgid "No connected devices were found. Add protected MAC addresses manually if needed."
msgstr "No connected devices were found. Add protected MAC addresses manually if needed."

msgid "Device discovery is unavailable. Add protected MAC addresses manually."
msgstr "Device discovery is unavailable. Add protected MAC addresses manually."

