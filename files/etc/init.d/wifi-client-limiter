#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10
# Keep startup failures visible to read-only LuCI users. These callers pass
# fixed strings only. The station adapter encodes variable driver details.
service_status() {
 local state="$1" error="${2:-}" detail="${3:-}" directory=/tmp/wifi-client-limiter
 umask 077
 mkdir -p "$directory" || return 1
 printf '{"service_state":"%s","error":"%s","detail":"%s","pid":0}\n' "$state" "$error" "$detail" > "$directory/service-status.json.tmp-$$" &&
  mv "$directory/service-status.json.tmp-$$" "$directory/service-status.json"
}
service_failure() { service_status error "$1" "$2"; logger -t wifi-client-limiter "$2"; return 1; }
start_service() {
 service_status starting || return 1
 command -v nft >/dev/null 2>&1 || { service_failure nft_missing 'nftables is missing; the complete limiter was not started'; return 1; }
 if ! command -v fw3 >/dev/null 2>&1 && ! command -v fw4 >/dev/null 2>&1; then
  service_failure firewall_backend_required 'The native OpenWrt firewall backend is missing; the complete limiter was not started'
  return 1
 fi
 for helper in internet-policy.sh station-adapter.sh vendor-acceleration.sh; do
  [ -x "/usr/share/wifi-client-limiter/$helper" ] || { service_failure helper_missing "Required helper is missing: $helper"; return 1; }
 done
 /usr/share/wifi-client-limiter/station-adapter.sh preflight || { logger -t wifi-client-limiter 'WiFi driver preflight failed; check the system log'; return 1; }
 rm -rf /tmp/wifi-client-limiter/lock
 procd_open_instance
 procd_set_param command /usr/sbin/wifi-client-limiter
 procd_set_param respawn 3600 5 5
 # Give the TERM handler time to restore owned firewall options cleanly.
 procd_set_param term_timeout 35
 procd_set_param file /etc/config/wifi-client-limiter
 procd_close_instance
}
service_stopped() {
 local failed=0
 /usr/share/wifi-client-limiter/station-adapter.sh cleanup || failed=1
 /usr/share/wifi-client-limiter/internet-policy.sh cleanup || failed=1
 if [ "$failed" = 0 ]; then service_status stopped
 else service_status error cleanup_failed 'Owned policy could not be fully removed; check the system log'; fi
 return "$failed"
}
service_triggers() { procd_add_reload_trigger wifi-client-limiter wireless network; }
reload_service() { stop; start; }
